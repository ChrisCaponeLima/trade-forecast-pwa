generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RelatPerformance {
  ativo             String   @db.VarChar(20)
  abertura          DateTime
  fechamento        DateTime
  qtdCompra         Int      @default(0)
  qtdVenda          Int      @default(0)
  resIntervaloBruto Decimal  @default(0.00) @db.Decimal(15, 2)
  lotes             Int      @default(0) @map("lotes")
  criadoEm          DateTime @default(now()) @map("criadoEm") @db.Timestamp(6)
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @map("id") @db.Uuid

  @@index([abertura], map: "idx_relat_performance_abertura")
  @@index([ativo], map: "idx_relat_performance_ativo")
  @@map("RelatPerformance")
}

model Retirada {
  id             String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  semanaId       String
  sacado         Sacado
  valorDevido    Float
  valorRetirado  Float
  dataRetirada   DateTime?
  status         StatusTransferencia @default(PENDENTE)
  createdAt      DateTime            @default(now())
  SemanaForecast SemanaForecast      @relation(fields: [semanaId], references: [id])
}

model SemanaForecast {
  id                 String     @id @default(dbgenerated("(uuid_generate_v4())::text"))
  semanaAno          Int
  semanaMes          Int
  mes                String
  metaRendimento     Float      @default(0.0)
  metaAcumulada      Float      @default(0.0)
  resultadoRealizado Float      @default(0.0)
  devidoChris        Float      @default(0.0)
  devidoVania        Float      @default(0.0)
  createdAt          DateTime   @default(now())
  Retirada           Retirada[]
}

enum Sacado {
  CHRIS
  VANIA
}

enum StatusTransferencia {
  PENDENTE
  CONCLUIDO
}
